{
  "name": "iipage",
  "productName": "iiPage",
  "version": "1.0.0",
  "description": "一个功能强大的智能白板应用",
  "main": "dist-electron/main.cjs",
  "private": true,
  "type": "module",
  "author": "iiPage Team",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && npm run electron:dev\"",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "tsc -b && vite build",
    "build:electron": "vite build --config vite-electron.config.ts",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^1.0.6",
    "@supabase/supabase-js": "^2.50.0",
    "@types/html2canvas": "^0.5.35",
    "@types/react-virtualized-auto-sizer": "^1.0.8",
    "@types/uuid": "^10.0.0",
    "@uiw/react-markdown-preview": "^5.1.4",
    "@uiw/react-md-editor": "^4.0.7",
    "@xyflow/react": "^12.6.4",
    "ali-oss": "^6.23.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "github-markdown-css": "^5.8.1",
    "html2canvas": "^1.4.1",
    "image-extensions": "^1.1.0",
    "is-url": "^1.2.4",
    "katex": "^0.16.22",
    "node-fetch": "^3.3.2",
    "prismjs": "^1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^7.6.2",
    "react-syntax-highlighter": "^15.6.1",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^6.1.1",
    "remark-breaks": "^4.0.0",
    "remark-emoji": "^5.0.1",
    "remark-footnotes": "^5.0.0",
    "remark-gfm": "^3.0.1",
    "remark-math": "^6.0.0",
    "slate": "^0.117.0",
    "slate-dom": "^0.116.0",
    "slate-history": "^0.113.1",
    "slate-md-serializer": "^5.5.4",
    "slate-react": "^0.116.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/ali-oss": "^6.16.11",
    "@types/is-url": "^1.2.32",
    "@types/lru-cache": "^7.10.9",
    "@types/node": "^24.0.3",
    "@types/react": "18",
    "@types/react-dnd": "^2.0.36",
    "@types/react-dnd-html5-backend": "^3.0.2",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-window": "^1.8.8",
    "@types/slate": "^0.47.16",
    "@types/slate-react": "^0.50.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.5",
    "electron-builder": "^26.0.12",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.iipage.whiteboard",
    "productName": "iiPage",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
